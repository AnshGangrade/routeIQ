# RouteIQ Environment Configuration
# Copy this file to .env and fill in actual values
# NEVER commit .env to version control

# Runtime LLM Configuration (for heuristic generation during evolution)
# This is NOT Kiro's model - this is the LLM that generates routing heuristics
LLM_PROVIDER=openai
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.7

# Alternative providers (uncomment and configure as needed):
# For Groq:
# LLM_PROVIDER=openai
# LLM_API_KEY=your_groq_key_here
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-70b-versatile

# For Google Gemini (via OpenAI-compatible endpoint):
# LLM_PROVIDER=openai
# LLM_API_KEY=your_gemini_key_here
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.8-flash
# Note: Gemini API keys from https://aistudio.google.com/app/apikey
# Note: Base URL must end with trailing slash /openai/

# For local/open-source models:
# LLM_PROVIDER=local
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=codellama

# Application Settings
LOG_LEVEL=INFO
DEBUG=false

# API Configuration (for FastAPI backend)
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
